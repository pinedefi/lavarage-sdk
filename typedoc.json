{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": ["./index.ts"],
    "out": "docs",
    "name": "Lavarage SDK Documentation",
    // "readme": "",
    "includeVersion": true,
    "excludePrivate": true,
    "excludeProtected": false,
    "excludeInternal": true,
    "navigationLinks": {
        "NPM": "https://www.npmjs.com/package/@lavarage/sdk"
    },
    "categorizeByGroup": true,
    "defaultCategory": "Other",
    "categoryOrder": [
        "Core",        
        "Offer",
        "Position",
        "Pool",
        "Lender",
        "Token",
        "Solana",
        "EVM",
        "*"
    ]

}